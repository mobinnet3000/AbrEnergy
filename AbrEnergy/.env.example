# Copy to `.env` and adjust. Never commit the real `.env`.

# ---- Development (default) ----
SECRET_KEY=insecure-dev-key-change-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
DB_ENGINE=postgresql
DB_NAME=abrenv_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Production (set DJANGO_SETTINGS_MODULE=config.settings.production) ----
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=False
# SECRET_KEY=<strong, unique value>   # production refuses the dev default above
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# SITE_URL=https://api.your-domain.com
# NUM_PROXIES=1                       # count of trusted reverse proxies in front of Django (1 for Nginx, 2 if behind Cloudflare/ALB)
# REDIS_URL=redis://redis:6379/0      # inside docker compose network, or external Redis URL
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# SENTRY_DSN=                         # optional; requires sentry-sdk (requirements/production.txt)
