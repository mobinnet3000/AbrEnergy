# Copy to `.env.local` for development or `.env.production` for production.
# Never commit `.env.local` or `.env.production`.

# ---- Development Defaults ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Opt-in development homepage preview fixtures (active ONLY when NODE_ENV !== 'production')
# NEXT_PUBLIC_HOMEPAGE_PREVIEW=1

# ---- Production Deployment (Configure on production server) ----
# NEXT_PUBLIC_API_URL=https://api.abarenergy.ir/api/v1
# NEXT_PUBLIC_SITE_URL=https://abarenergy.ir
